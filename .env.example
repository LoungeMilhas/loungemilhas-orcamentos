# ============================================================
# Lounge Milhas - Orcamentos | Variaveis de ambiente (exemplo)
# Copie para .env.local (NUNCA versionar valores reais).
# Use o projeto Supabase DEV em desenvolvimento e o PROD em producao.
# ============================================================

# --- Supabase (publicas, expostas ao browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (SECRETA, somente server-side / jobs) ---
# NUNCA expor ao browser. Usada por Server Actions/cron com privilegio total.
SUPABASE_SERVICE_ROLE_KEY=

# --- Protecao da URL publica ---
# Segredo para assinar o token de handshake (cookie HttpOnly) do link compartilhado.
ORCAMENTO_SHARE_SECRET=

# --- Jobs / Cron (Vercel Cron -> rotas api/cron/*) ---
# Header secreto exigido para acionar as rotas de cron (expiracao / limpeza Storage).
CRON_SECRET=

# ============================================================
# FASE 2 (ainda nao usados na Fase 1 - deixar vazio)
# ============================================================
# GOOGLE_PLACES_API_KEY=
# ANTHROPIC_API_KEY=
